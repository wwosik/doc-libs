<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Brands for the wwosik.DocLibs document generators: colours, fonts, logo, footer and cover images, in code or as brand packs (brand.json plus files), the vector drawing model code-block renderers produce, QR codes, the Tabler outline icons, the Liberation fonts, document checks and DocumentTool, a tool description for AI agents that write documents through the generators. Shared by the PPTX, DOCX and PDF generators.</Description>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\wwosik.DocLibs.DocumentConversions\wwosik.DocLibs.DocumentConversions.csproj" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icons\tabler-outline.txt.gz" LogicalName="Icons.tabler-outline.txt.gz" />
    <EmbeddedResource Include="Fonts\*.ttf" LogicalName="Fonts.%(Filename)%(Extension)" />
    <None Include="Fonts\OFL.txt" Pack="true" PackagePath="Fonts\OFL.txt" />
    <None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="wwosik.DocLibs.DocumentGeneration.Tests" />
    <InternalsVisibleTo Include="wwosik.DocLibs.DocumentGeneration.Pptx" />
    <InternalsVisibleTo Include="wwosik.DocLibs.DocumentGeneration.Pptx.Tests" />
    <InternalsVisibleTo Include="wwosik.DocLibs.DocumentGeneration.Docx" />
    <InternalsVisibleTo Include="wwosik.DocLibs.DocumentGeneration.Docx.Tests" />
    <InternalsVisibleTo Include="wwosik.DocLibs.DocumentGeneration.Pdf" />
    <InternalsVisibleTo Include="wwosik.DocLibs.DocumentGeneration.Pdf.Tests" />
    <InternalsVisibleTo Include="wwosik.DocLibs.DocumentGeneration.Diagrams" />
    <InternalsVisibleTo Include="wwosik.DocLibs.DocumentGeneration.Diagrams.Tests" />
    <InternalsVisibleTo Include="wwosik.DocLibs.DocumentGeneration.Charts" />
    <InternalsVisibleTo Include="wwosik.DocLibs.DocumentGeneration.Charts.Tests" />
  </ItemGroup>

</Project>
