    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\wwosik.DocLibs.DocumentConversions\wwosik.DocLibs.DocumentConversions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="wwosik.DocLibs.DocumentGeneration.Tests" />
    <InternalsVisibleTo Include="wwosik.DocLibs.DocumentGeneration.Pptx" />
    <InternalsVisibleTo Include="wwosik.DocLibs.DocumentGeneration.Pptx.Tests" />
    <InternalsVisibleTo Include="wwosik.DocLibs.DocumentGeneration.Pdf" />
    <InternalsVisibleTo Include="wwosik.DocLibs.DocumentGeneration.Pdf.Tests" />
    <InternalsVisibleTo Include="wwosik.DocLibs.DocumentGeneration.Diagrams" />
    <InternalsVisibleTo Include="wwosik.DocLibs.DocumentGeneration.Diagrams.Tests" />
  </ItemGroup>

</Project>
