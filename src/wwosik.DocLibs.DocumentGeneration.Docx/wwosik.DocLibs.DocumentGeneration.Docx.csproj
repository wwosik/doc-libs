<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Generates Word documents (.docx) from Markdown, on a built-in template in a brand's design or on a caller's template, with numbered headings, real footnotes, a table of contents and native charts.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\wwosik.DocLibs.DocumentGeneration\wwosik.DocLibs.DocumentGeneration.csproj" />
  </ItemGroup>

  <!-- Open XML code shared with the PPTX generator, compiled into each as internal source. -->
  <ItemGroup>
    <Compile Include="..\Shared\OpenXml\*.cs" Link="Shared\OpenXml\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- `.grey` on images, shared with the PDF generator as internal source. -->
  <ItemGroup>
    <Compile Include="..\Shared\Imaging\GreyImages.cs" Link="Shared\Imaging\GreyImages.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="THIRD-PARTY-NOTICES.txt" />
    <EmbeddedResource Include="AuthoringGuide\*.md" LogicalName="AuthoringGuide.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="wwosik.DocLibs.DocumentGeneration.Docx.Tests" />
  </ItemGroup>

</Project>
