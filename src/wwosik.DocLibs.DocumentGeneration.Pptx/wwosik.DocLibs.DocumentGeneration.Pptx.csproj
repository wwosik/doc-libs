<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Generates PowerPoint presentations (.pptx) from Markdown, on the built-in master in a brand's design or on a caller's template, with the brand's fonts embedded; and any deck as a self-contained HTML page.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\wwosik.DocLibs.DocumentGeneration\wwosik.DocLibs.DocumentGeneration.csproj" />
  </ItemGroup>

  <!-- Open XML code shared with the DOCX generator, compiled into each as internal source. -->
  <ItemGroup>
    <Compile Include="..\Shared\OpenXml\*.cs" Link="Shared\OpenXml\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="AuthoringGuide\*.md" LogicalName="AuthoringGuide.%(Filename)%(Extension)" />
    <EmbeddedResource Include="HtmlDeck\deck.js;HtmlDeck\deck.css" LogicalName="HtmlDeck.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="wwosik.DocLibs.DocumentGeneration.Pptx.Tests" />
    <InternalsVisibleTo Include="wwosik.DocLibs.DocumentConversions.Svg.Tests" />
  </ItemGroup>

</Project>
