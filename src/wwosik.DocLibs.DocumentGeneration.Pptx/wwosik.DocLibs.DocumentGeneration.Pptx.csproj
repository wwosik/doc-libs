<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Generates PowerPoint presentations (.pptx) from Markdown, on the built-in master in a brand's design or on a caller's template, with the brand's fonts embedded.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\wwosik.DocLibs.DocumentGeneration\wwosik.DocLibs.DocumentGeneration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="AuthoringGuide\*.md" LogicalName="AuthoringGuide.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="wwosik.DocLibs.DocumentGeneration.Pptx.Tests" />
  </ItemGroup>

</Project>
